# CEKBAO configuration. Copy to .env and export the values in your shell.
# Never commit a real .env file. .gitignore excludes it.

# SQLite database path (created on first start).
CEKBAO_DB_PATH=data/cekbao.sqlite3
# Session lifetime in minutes.
CEKBAO_SESSION_TTL_MINUTES=30
# Seed the synthetic demo personas from fixtures/demo_users.json (1 = on, 0 = off).
CEKBAO_DEMO_USERS=1
# Set to 1 behind HTTPS so the session cookie gets the Secure flag.
CEKBAO_COOKIE_SECURE=0

# Optional OpenAI-compatible LLM endpoint for field extraction.
# Leave all three empty to run DETERMINISTIC DEMO MODE (no model call).
# Only redacted message text is sent. Deterministic code decides every status.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
