# CEKBAO configuration. Copy to .env and export the values in your shell.
# Never commit a real .env file. .gitignore excludes it.

# SQLite database path (created on first start).
CEKBAO_DB_PATH=data/cekbao.sqlite3
# Session lifetime in minutes.
CEKBAO_SESSION_TTL_MINUTES=30
# Seed the synthetic demo personas from fixtures/demo_users.json (1 = on, 0 = off).
CEKBAO_DEMO_USERS=1
# Set to 1 behind HTTPS so the session cookie gets the Secure flag.
CEKBAO_COOKIE_SECURE=0

# Optional OpenAI-compatible LLM endpoint for field extraction.
# Leave all three empty to run DETERMINISTIC DEMO MODE (no model call).
# Only redacted message text is sent. Deterministic code decides every status.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# CEKBAO PolicyGuard local configuration. Copy to .env.local (git-ignored) and fill in values.
# Never commit .env.local. Never paste keys into chat, tickets or logs.

# Enable PolicyGuard inside the CEKBAO app (scripts/policyguard_serve.sh sets this).
PG_ENABLED=1
PG_DATABASE_URL=postgresql+psycopg://policyguard@127.0.0.1:55432/policyguard
PG_REDIS_URL=redis://127.0.0.1:56379/0
PG_STORAGE_DIR=.local/objects
# Random secret for signed upload URLs (32+ bytes). Generated per process when empty.
PG_UPLOAD_SIGNING_KEY=

# NVIDIA model through Nebius Token Factory. Paid inference stays OFF unless all four values are set.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_API_KEY=
# Approved budget in USD and a hard cap on paid calls (both required; the ledger refuses calls beyond them).
PG_INFERENCE_BUDGET_USD=
PG_MAX_PAID_CALLS=
# List prices used for worst-case reservation (USD per 1M tokens, Nebius page checked 2026-10-28).
PG_PRICE_IN_PER_MTOK=0.06
PG_PRICE_OUT_PER_MTOK=0.24

# Optional: console export of OpenTelemetry spans.
PG_OTEL_CONSOLE=0
